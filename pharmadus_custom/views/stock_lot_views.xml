<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mover campo Descripción (note) fuera del notebook, al pie del formulario -->
    <record id="view_production_lot_form_custom" model="ir.ui.view">
        <field name="name">stock.lot.form.custom</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <!-- Eliminar solo la pestaña Descripción, dejando el notebook intacto -->
            <xpath expr="//page[@name='description']" position="replace"/>
            <!-- Añadir el campo note al final del sheet, sin pestaña -->
            <xpath expr="//group[@name='main_group']" position="after">
                <field name="note" nolabel="1"
                    placeholder="Descripción..."
                    invisible="not display_complete"/>
            </xpath>
        </field>
    </record>
</odoo>
