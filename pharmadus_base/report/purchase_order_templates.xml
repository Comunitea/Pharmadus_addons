<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_pharmadus_requisition" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[@id='informations']/div[div[@t-field='o.partner_ref']]" position="replace">
            <div t-if="o.partner_ref or o.requisition_id" class="col">
                <t t-if="o.partner_ref">
                    <strong>Your Order Reference</strong>
                    <div t-field="o.partner_ref"/>
                </t>
                <div t-if="o.requisition_id" t-att-class="'mt-2' if o.partner_ref else ''">
                    <strong>Licitación</strong>
                    <div t-field="o.requisition_id.name"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
