<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="report_saletransfer_document">
    <t t-call="web.external_layout">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <t t-set="address">
            <div t-field="doc.partner_id"
                t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
            <p t-if="doc.partner_id.vat">
                <t t-if="doc.company_id.account_fiscal_country_id.vat_label"
                    t-out="doc.company_id.account_fiscal_country_id.vat_label"/>
                <t t-else="">Tax ID</t>: <span t-field="doc.partner_id.vat"/>
            </p>
        </t>
        <t t-if="doc.partner_shipping_id and doc.partner_shipping_id != doc.partner_id">
            <t t-set="information_block">
                <strong>Shipping Address</strong>
                <div t-field="doc.partner_shipping_id"
                    t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
            </t>
        </t>
        <div class="page">
            <div class="oe_structure"/>

            <t t-set="layout_document_title">
                <span>Transfer # </span>
                <span t-out="doc.id">0</span>
            </t>

            <div class="row mb-4" id="informations">
                <div t-if="doc.partner_id" class="col" name="informations_customer">
                    <strong>Customer</strong>
                    <div t-field="doc.partner_id"/>
                </div>
                <div t-if="doc.cooperative_id" class="col" name="informations_cooperative">
                    <strong>Cooperative</strong>
                    <div t-field="doc.cooperative_id"/>
                </div>
                <div t-if="doc.date_order" class="col" name="informations_date">
                    <strong>Order Date</strong>
                    <div t-field="doc.date_order" t-options='{"widget": "date"}'/>
                </div>
            </div>

            <div class="oe_structure"/>
            <table class="o_has_total_table table o_main_table table-borderless">
                <thead style="display: table-row-group">
                    <tr>
                        <th name="th_description" class="text-start">Description</th>
                        <th name="th_quantity" class="text-end text-nowrap">Quantity</th>
                        <th name="th_uom" class="text-end text-nowrap">UoM</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="doc.order_line" t-as="line">
                        <tr t-att-class="'fw-bold o_line_section' if line.display_type == 'line_section'
                                         else 'fst-italic o_line_note' if line.display_type == 'line_note'
                                         else ''">
                            <t t-if="not line.display_type">
                                <td name="td_name">
                                    <span t-field="line.product_id.display_name"/>
                                </td>
                                <td name="td_quantity" class="text-end">
                                    <span t-field="line.product_uom_qty" class="text-nowrap"/>
                                </td>
                                <td name="td_uom" class="text-end">
                                    <span t-field="line.product_uom"/>
                                </td>
                            </t>
                            <t t-elif="line.display_type == 'line_section'">
                                <td name="td_section_line" colspan="99">
                                    <span t-field="line.product_id.display_name"/>
                                </td>
                            </t>
                            <t t-elif="line.display_type == 'line_note'">
                                <td name="td_note_line" colspan="99">
                                    <span t-field="line.product_id.display_name"/>
                                </td>
                            </t>
                        </tr>
                    </t>
                </tbody>
            </table>

            <div class="oe_structure"/>
        </div>
    </t>
</template>

<template id="report_saletransfer">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="pharmadus_base.report_saletransfer_document" t-lang="doc.partner_id.lang"/>
        </t>
    </t>
</template>

</odoo>
