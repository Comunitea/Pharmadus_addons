        <field name="name">Rec. - Etiqueta de muestreo</field>
        <field name="model">stock.lot</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pharmadus_base.report_lot_sampling_reception_label</field>
        <field name="report_file">pharmadus_base.report_lot_sampling_reception_label</field>
        <field name="paperformat_id" ref="pharmadus_base.paperformat_lot_reception_labels_pharmadus"/>
        <field name="print_report_name">'Rec. - Etiqueta de muestreo - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_lot"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_lot_sampled_package_label" model="ir.actions.report">
        <field name="name">Rec. - Envase muestreado</field>
        <field name="model">stock.lot</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pharmadus_base.report_lot_sampled_package_label</field>
        <field name="report_file">pharmadus_base.report_lot_sampled_package_label</field>
        <field name="paperformat_id" ref="pharmadus_base.paperformat_lot_reception_labels_pharmadus"/>
        <field name="print_report_name">'Rec. - Envase muestreado - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_lot"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_lot_approved_label" model="ir.actions.report">
        <field name="name">Etiqueta de aprobado</field>
        <field name="model">stock.lot</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pharmadus_base.report_lot_approved_label</field>
        <field name="report_file">pharmadus_base.report_lot_approved_label</field>
        <field name="paperformat_id" ref="pharmadus_base.paperformat_lot_state_labels_pharmadus"/>
        <field name="print_report_name">'Etiqueta de aprobado - %s' % (object.name)</field>
