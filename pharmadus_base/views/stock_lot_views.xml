<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_form_pharmadus_reception" model="ir.ui.view">
        <field name="name">stock.lot.form.pharmadus.reception</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_pharmadus_move_history"
                    type="object"
                    class="oe_stat_button"
                    icon="oi-arrow-up"
                    help="Historial de movimientos"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Trazabilidad simple</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="pharmadus_reception" string="Recepción">
                    <group>
                        <group>
                            <field name="pharmadus_packaging_type_id"/>
                            <field name="pharmadus_package_count"/>
                            <field name="pharmadus_pallet_count"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_stock_lot_form_quality_buttons" model="ir.ui.view">
        <field name="name">stock.lot.form.quality.buttons</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock_lot_state.view_production_lot_form_state"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_set_approved']" position="attributes">
                <attribute name="groups">quality_control_oca.group_quality_control_manager</attribute>
            </xpath>
            <xpath expr="//button[@name='action_set_rejected']" position="attributes">
                <attribute name="groups">quality_control_oca.group_quality_control_manager</attribute>
            </xpath>
            <xpath expr="//button[@name='action_set_pending']" position="attributes">
                <attribute name="groups">quality_control_oca.group_quality_control_manager</attribute>
            </xpath>
        </field>
    </record>
</odoo>
