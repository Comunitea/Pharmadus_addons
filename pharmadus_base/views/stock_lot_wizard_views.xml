<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_creation_wizard_form" model="ir.ui.view">
        <field name="name">stock.lot.creation.wizard.form</field>
        <field name="model">stock.lot.creation.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="lot_name"/>
                        <field name="product_id"/>
                        <field name="packaging_type_id"/>
                        <field name="package_count"/>
                        <field name="pallet_count"/>
                        <field name="source_move_id" invisible="1"/>
                        <field name="source_picking_id" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="create_lot_and_assign"
                        string="Crear y asignar lote"
                        type="object"
                        class="btn-primary"/>
                    <button
                        string="Cancelar"
                        class="btn-secondary"
                        special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_stock_lot_creation_wizard" model="ir.actions.act_window">
        <field name="name">Crear lote</field>
        <field name="res_model">stock.lot.creation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_stock_move_line_operation_tree_pharmadus_lot_creation" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.pharmadus.lot.creation</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_name']" position="attributes">
                <attribute name="string">Lote</attribute>
            </xpath>
            <xpath expr="(//field[@name='location_dest_id'])[last()]" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="(//field[@name='result_package_id'])[last()]" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='lot_name']" position="after">
                <field name="pharmadus_packaging_type_id"
                       string="Tipo envase"
                       groups="stock.group_production_lot"
                       column_invisible="parent.has_tracking == 'none' or not parent.show_lots_text"/>
                <field name="pharmadus_package_count"
                       string="Envases"
                       groups="stock.group_production_lot"
                       column_invisible="parent.has_tracking == 'none' or not parent.show_lots_text"/>
                <field name="pharmadus_pallet_count"
                       string="Pallets"
                       groups="stock.group_production_lot"
                       column_invisible="parent.has_tracking == 'none' or not parent.show_lots_text"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_operation_tree_pharmadus_expiry_labels" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.pharmadus.expiry.labels</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="product_expiry.view_stock_move_line_operation_tree_expiry"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='expiration_date']" position="attributes">
                <attribute name="string">Caducidad</attribute>
                <attribute name="column_invisible">True</attribute>
            </xpath>
        </field>
    </record>
</odoo>
