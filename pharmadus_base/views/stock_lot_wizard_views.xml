<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_creation_wizard_form" model="ir.ui.view">
        <field name="name">stock.lot.creation.wizard.form</field>
        <field name="model">stock.lot.creation.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="lot_name"/>
                        <field name="product_id"/>
                        <field name="packaging_type_id"/>
                        <field name="package_count"/>
                        <field name="pallet_count"/>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="create_lot_and_assign"
                        string="Crear y asignar lote"
                        type="object"
                        class="btn-primary"
                        default_manager_group_ids="[(4, product.group_product_user)]"/>
                    <button
                        name="_close"
                        string="Cancelar"
                        type="object"
                        class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_stock_lot_creation_wizard" model="ir.actions.act_window">
        <field name="name">Crear lote</field>
        <field name="res_model">stock.lot.creation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Add button to stock picking form -->
    <record id="view_picking_form_pharmadus_lot_creation" model="ir.ui.view">
        <field name="name">stock.picking.form.pharmadus.lot.creation</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='do_print_picking']" position="after">
                <button
                    name="action_stock_lot_creation_wizard"
                    string="Crear lote"
                    type="action"
                    groups="product.group_product_user,inventorystock.group_informer"
                    invisible="picking_type_code != 'incoming' or state in ('draft', 'cancel') or not lot_id"/>
            </xpath>
        </field>
    </record>
</odoo>
