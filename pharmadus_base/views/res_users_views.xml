<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_pharmadus_signature" model="ir.ui.view">
        <field name="name">res.users.form.pharmadus.signature</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']/group[@name='messaging']" position="after">
                <group name="pharmadus_signature" string="Firma manuscrita">
                    <field name="pharmadus_signature_image" widget="image" options="{'preview_image': 'pharmadus_signature_image'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
