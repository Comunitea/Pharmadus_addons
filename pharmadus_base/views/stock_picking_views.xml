<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_pharmadus_lot_labels" model="ir.ui.view">
        <field name="name">stock.picking.form.pharmadus.lot.labels</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='do_print_picking']" position="after">
                <button
                    name="%(action_report_lot_labels)d"
                    string="Imprimir etiquetas de lotes"
                    type="action"
                    groups="stock.group_production_lot"
                    invisible="picking_type_code != 'incoming' or state in ('draft', 'cancel') or not lot_id"
                />
            </xpath>
        </field>
    </record>
</odoo>
