<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-inherit="stock.ForecastedDetails" t-inherit-mode="extension">
        <xpath expr="//a[@t-if='line.document_in']" position="replace">
            <!-- Keep the original t-if/t-elif flow intact; inserting after the
                 anchor breaks the surrounding conditional chain in Owl. -->
            <t t-if="line.document_in">
                <a
                    href="#"
                    t-on-click.prevent="() => this.props.openView(line.document_in._name, 'form', line.document_in.id)"
                    t-out="line.document_in.name"
                    class="fw-bold"
                />
                <span
                    t-if="line.document_in.partner_name"
                    t-out="' ' + line.document_in.partner_name"
                />
                <span
                    t-if="line.document_in.product_name"
                    t-out="' (' + line.document_in.product_name + ')'"
                />
                <span
                    t-if="line.replenishment_filled and !line.document_out"
                    class="fw-bold"
                >
                    Stock libre
                </span>
            </t>
        </xpath>
        <xpath expr="//a[@t-if='line.document_out']" position="after">
            <span
                t-if="line.document_out and line.document_out.partner_name"
                t-out="' ' + line.document_out.partner_name"
            />
            <span
                t-if="line.document_out and line.document_out.product_name"
                t-out="' (' + line.document_out.product_name + ')'"
            />
        </xpath>
        <xpath expr="//tr[@name='draft_po_in']//a" position="after">
            <span
                t-if="purchase_order and purchase_order.partner_name"
                t-out="' ' + purchase_order.partner_name"
            />
        </xpath>
    </t>
</templates>
