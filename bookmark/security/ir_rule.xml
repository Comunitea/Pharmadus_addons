<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.rule" id="my_search_history_rule">
        <field name="name">My Search History</field>
        <field name="model_id" ref="bookmark.model_search_history"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('user_ids', 'in', [user.id])]</field>
    </record>

    <record model="ir.rule" id="search_history_admin_rule">
        <field name="name">Search History Admin</field>
        <field name="model_id" ref="bookmark.model_search_history"/>
        <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
        <field name="domain_force">[(1, "=", 1)]</field>
    </record>

    <record model="ir.rule" id="my_bookmark_rule">
        <field name="name">Bookmark</field>
        <field name="model_id" ref="bookmark.model_res_bookmark"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('user_ids', 'in', [user.id])]</field>
    </record>

    <record model="ir.rule" id="bookmark_admin_rule">
        <field name="name">Bookmark Admin</field>
        <field name="model_id" ref="bookmark.model_res_bookmark"/>
        <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
        <field name="domain_force">[(1, "=", 1)]</field>
    </record>

</odoo>
