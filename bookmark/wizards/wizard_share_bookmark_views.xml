<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wizard_share_bookmark_form" model="ir.ui.view">
        <field name="name">wizard.share.bookmark.form</field>
        <field name="model">wizard.share.bookmark</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="bookmark_ids" widget="many2many_tags" options="{'no_create':True}"/>
                    </group>
                    <group>
                        <field name="user_ids" widget="many2many_tags" options="{'no_create':True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_share"
                            string="Share"
                            class="btn-primary" type="object"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_share_bookmark_action" model="ir.actions.act_window">
        <field name="name">Share Bookmark</field>
        <field name="res_model">wizard.share.bookmark</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
