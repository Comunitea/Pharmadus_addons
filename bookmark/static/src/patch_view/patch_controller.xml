<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="control_panel_suggest_inherit" t-inherit="web.ControlPanel" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('o_control_panel_main')]" position="after">
            <SearchHistory/>
        </xpath>
        <xpath expr="//div[hasclass('o_control_panel')]" position="attributes">
            <attribute name="class">o_control_panel d-flex flex-column gap-2 px-3 pt-2 pb-3</attribute>
        </xpath>
    </t>

</templates>
