<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="search_history_form" model="ir.ui.view">
        <field name="name">search.history.form</field>
        <field name="model">search.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="type"/>
                            <field name="model_id"/>
                            <field name="search_view_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="favorite_id"/>
                            <field name="description"/>
                            <field name="value"/>
                            <field name="custom"/>
                            <field name="user_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="search_history_list" model="ir.ui.view">
        <field name="name">search.history.list</field>
        <field name="model">search.history</field>
        <field name="arch" type="xml">
            <list>
                <field name="type"/>
                <field name="model_id"/>
                <field name="search_view_id"/>
                <field name="name"/>
                <field name="favorite_id"/>
                <field name="description"/>
                <field name="value"/>
                <field name="custom"/>
                <field name="user_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="search_history_search" model="ir.ui.view">
        <field name="name">search.history.search</field>
        <field name="model">search.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_id"/>
                <field name="search_view_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group string="Group By" expand="0" name="groupby">
                    <filter string="Model" name="model_id" context="{'group_by': 'model_id'}"/>
                    <filter string="Search View" name="search_view_id" context="{'group_by': 'search_view_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="search_history_action" model="ir.actions.act_window">
        <field name="name">Search History</field>
        <field name="res_model">search.history</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem parent="base.next_id_2" name="Search History"
        id="menu_search_history" action="search_history_action" sequence="6"/>
</odoo>
